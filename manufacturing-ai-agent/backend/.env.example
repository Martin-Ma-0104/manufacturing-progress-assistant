# Copy this file to backend/.env. Keep every actual key server-side.
# No model key is needed for production, calculations or default local retrieval.
LLM_API_KEY=
# Alternatively set OPENAI_API_KEY in your process environment.
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_PROVIDER=local-hash-v1
# Optional semantic embeddings: openai (each upload/query needs explicit permission).
EMBEDDING_MODEL=text-embedding-3-small
# Defaults: repository manufacturing.db (read-only) and backend/storage.
# PRODUCTION_DB=/absolute/path/to/manufacturing.db
# KNOWLEDGE_DIR=/absolute/path/to/separate/knowledge-storage
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
